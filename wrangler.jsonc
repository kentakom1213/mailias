{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mailias",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-14",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 }
  },
  "secrets": {
    "required": ["MAILIAS_SECRET", "FORWARD_TO"]
  }
}
